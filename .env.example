# All money values below are integer paise. Blank values keep paid actions disabled.
# Never prefix secrets with VITE_. Copy to .env locally, keep it out of Git.
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Server Firebase Admin uses Application Default Credentials.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Same provider account and mode for checkout, webhook and refunds.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GEMINI_API_KEY=
# Choose an image-capable model available in your account; confirm current pricing first.
GEMINI_IMAGE_MODEL=

# Set an approved retail price only after reviewing all costs.
TRYON_PRICE_PAISE=
PROVIDER_MAX_COST_PAISE=
# Include fixed payment fees, infrastructure and any per-job processing overhead.
JOB_OVERHEAD_PAISE=
PAYMENT_FEE_BPS=400
TAX_RESERVE_BPS=1800
MIN_MARGIN_PAISE=100
DAILY_AI_BUDGET_PAISE=
MAX_USER_DAILY_JOBS=5
PUBLISH_PRICE_PAISE=
PUBLISH_PASS_PRICE_PAISE=

# Comma-separated seed product IDs. Keep empty until each image has been reviewed.
APPROVED_TRYON_PRODUCT_IDS=
# Additional trusted HTTPS CDNs only. Never add arbitrary user-supplied hosts.
APPROVED_IMAGE_HOSTS=

# Meshy pilot: sponsored generation, restricted to explicit Firebase user IDs.
# Pin a supported model and review its maximum per-task credit charge first.
# Reservations are never refunded automatically, including unknown submissions.
MESHY_API_KEY=
MESHY_MODEL=
MESHY_MAX_TASK_CREDITS=
MESHY_DAILY_CREDIT_BUDGET=
MESHY_ALLOWED_UIDS=
# Required separately for texture changes; review the same task credit cap against its cost.
MESHY_TEXTURE_MODEL=
